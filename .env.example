# Root Docker Compose variables (copy ke `.env`)
#
# Lokal (docker-compose.yml):
#   APP_URL=http://localhost:8000
#   FRONTEND_URL=http://localhost:5173
#   GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
#
# Produksi (docker-compose.prod.yml) — nilai wajib HTTPS:
#   APP_URL=https://domainkamu.com
#   FRONTEND_URL=https://domainkamu.com
#   GOOGLE_REDIRECT_URI=https://domainkamu.com/api/v1/auth/google/callback
#   TRUSTED_PROXIES=*            # isi IP proxy/Cloudflare kalau tidak mau trust semua

DB_DATABASE=trackripsi
DB_USERNAME=trackripsi
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_KEY=

# Login Google (opsional). Redirect URI: ${APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
TRUSTED_PROXIES=*
